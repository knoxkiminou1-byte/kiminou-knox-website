{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @workspace/kiminou run dev",
    "generate:books": "node scripts/generate-books.mjs",
    "generate:seo": "pnpm run generate:books && node scripts/generate-seo.mjs",
    "prerender:seo": "node scripts/prerender-seo.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "build": "pnpm run generate:seo && pnpm run typecheck && pnpm --filter @workspace/kiminou run build && pnpm run prerender:seo",
    "typecheck": "pnpm --filter @workspace/kiminou run typecheck",
    "test:e2e": "playwright test",
    "validate": "pnpm run check:assets && pnpm run typecheck && pnpm run build"
  },
  "private": true,
  "dependencies": {
    "nodemailer": "^10.0.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.3.3",
    "prettier": "^3.8.3",
    "sharp": "^0.35.3",
    "typescript": "~5.9.3"
  }
}
